{
  "name": "@msimerson/hapi-openapi",
  "description": "A swagger documentation UI generator plugin for hapi",
  "version": "18.0.3",
  "author": "Glenn Jones (https://github.com/glennjones)",
  "contributors": [
    "Robert McGuinness (https://github.com/robmcguinness)",
    "Matt Simerson (https://github.com/msimerson)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msimerson/hapi-openapi.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "lib",
    "public",
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "api",
    "docs",
    "swagger",
    "hapi",
    "joi"
  ],
  "scripts": {
    "start": "node examples/simple.js",
    "start:openapi": "node examples/simple-openapi.js",
    "start:basic": "node examples/basic.js",
    "start:debug": "node examples/debug.js",
    "start:jwt": "node examples/jwt.js",
    "start:dot:grouping": "node examples/dot-grouping.js",
    "start:extend": "node examples/extend.js",
    "start:group:ordered": "node examples/group-ordered.js",
    "start:routes:simple": "node examples/group-ordered.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:lib",
    "test:lib:debug": "node --test --inspect-brk 'test/Integration/*-test.js' 'test/unit/*-test.js'",
    "test:ts": "tsc --noEmit",
    "test:lib": "node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=94 'test/Integration/*-test.js' 'test/unit/*-test.js'",
    "precommit": "pnpm test",
    "postversion": "pnpm publish",
    "postpublish": "git push origin --all; git push origin --tags",
    "prepare": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || husky",
    "clean": "rm -rf node_modules coverage",
    "versions": "npx npm-dep-mgr check",
    "versions:fix": "npx npm-dep-mgr update"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hapi/inert": "^7.1.2",
    "swagger-ui-dist": "^5.32.11"
  },
  "optionalDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.5.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^10.0.1",
    "@hapi/basic": "^7.0.2",
    "@hapi/h2o2": "^10.0.4",
    "@hapi/hapi": "^21.4.10",
    "@hapi/hoek": "^11.0.7",
    "@types/node": "^26.1.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "joi": "^18.2.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@hapi/hapi": ">=20.x.x",
    "joi": ">=18.x <19.x"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
